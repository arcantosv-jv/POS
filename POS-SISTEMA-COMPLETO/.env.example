# ====================================
# Database Configuration
# ====================================
# Railway proporciona DATABASE_URL automáticamente después de agregar PostgreSQL
# Para desarrollo local, usa estas variables:
DB_USER=pos_user
DB_PASSWORD=pos_secure_password_123
DB_NAME=pos_db
DB_HOST=db
DB_PORT=5432

# ====================================
# Flask Configuration
# ====================================
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-secret-key-change-in-production-12345678
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-87654321
DEBUG=False
TESTING=False

# ====================================
# IA Configuration - Google Gemini
# ====================================
IA_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy... (obtén tu clave de https://ai.google.dev)
GEMINI_MODEL=gemini-3.5-flash

# ====================================
# IA Configuration - OpenAI (opcional)
# ====================================
# Descomenta si quieres usar OpenAI en lugar de Gemini
# OPENAI_API_KEY=sk-...

# ====================================
# IA Configuration - Anthropic Claude (opcional)
# ====================================
# Descomenta si quieres usar Anthropic en lugar de Gemini
# ANTHROPIC_API_KEY=sk-ant-...

# ====================================
# Timezone
# ====================================
TIMEZONE=America/Mexico_City
